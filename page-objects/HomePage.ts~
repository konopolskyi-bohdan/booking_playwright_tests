import { Locator, Page } from '@playwright/test'

export class HomePage {
    readonly page: Page
    readonly searchButton: Locator
    readonly destinationInput: Locator
    readonly checkInField: Locator
    readonly checkOutField: Locator

    //всі локатори треба виносити в конструктор
    constructor(page: Page) {
        this.page = page
        this.searchButton = this.page.getByRole("button", { name: "Search" })
        this.destinationInput = page.locator('input[name="ss"]')
        this.checkInField = page.locator('[data-testid="date-display-field-start"]')
        this.checkOutField = page.locator('[data-testid="date-display-field-end"]')
    }

    //методи
    async visit() {
        await this.page.goto('')
    }

    // Метод-генератор локатора для дати
    async enterDestination(city: string) {
        await this.destinationInput.fill(city)
    }
    getDateCell(date: string): Locator {
        return this.page.locator(`[data-date="${date}"]`)
    }
    async selectDates(checkIn: string, checkOut: string) {
        await this.checkInField.click()
        await this.page.locator(`[data-date="${checkIn}"]`).click()

        await this.checkOutField.click()
        await this.page.locator(`[data-date="${checkOut}"]`).click()
    }
    async clickOnSearchButton() {
        await this.searchButton.click ()
    }
}