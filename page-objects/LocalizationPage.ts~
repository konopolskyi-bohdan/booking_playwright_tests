import { expect, Locator, Page } from '@playwright/test'

export class LocalizationPage {
    readonly page: Page
    readonly languageTrigger: Locator
    readonly allLanguagesSection: Locator

    constructor(page: Page) {
        this.page = page
        this.languageTrigger = page.locator('[data-testid="header-language-picker-trigger"]')
        this.allLanguagesSection = page.getByTestId('All languages')
    }

    async openLanguageMenu() {
        await expect(this.languageTrigger).toBeVisible()
        await this.languageTrigger.click()
    }

    async logAllLanguages() {
    const languageButtons = this.allLanguagesSection.locator('[data-testid="selection-item"]')
    const count = await languageButtons.count()
    const seen = new Set<string>()
        console.log(`Доступні мови (кнопки): ${count}`)

        for (let i = 0; i < count; i++) {
            const lang = (await languageButtons.nth(i).innerText()).trim()
            if (!seen.has(lang)) {
                seen.add(lang)
                console.log(`- ${lang}`)
            }
        }

        console.log(`Унікальних мов: ${seen.size}`)
    }

    async logCurrentLanguage() {
        const ariaLabel = await this.languageTrigger.getAttribute('aria-label')
        const innerText = await this.languageTrigger.innerText()
        const currentLanguage = ariaLabel?.split(':').pop()?.trim() || innerText.trim()

        console.log('aria-label:', ariaLabel)
        console.log('innerText:', innerText)
        console.log('Поточна мова за замовчуванням:', currentLanguage)

        const languageButton = this.allLanguagesSection.getByRole('button', {
            name: currentLanguage,
            exact: true
        })

        await expect(languageButton).toBeVisible()
    }

    async changeLanguageTo(language: string) {
        const targetButton = this.allLanguagesSection.getByRole('button', {
            name: language,
            exact: true
        })

        await expect(targetButton).toBeVisible()
        await targetButton.click()
    }

    async expectLanguageChangedTo(expected: string) {
        await expect(this.languageTrigger).toHaveAttribute('aria-label', new RegExp(expected))
    }
}

    async expectSpanishLanguageIsActive() {
        const headerButton = this.page.getByTestId('header-custom-action-button')
        await expect(headerButton).toHaveText('Registra tu alojamiento')

        const searchButton = this.page.getByRole('button', {name: 'Buscar'}) // "Search"
        await expect(searchButton).toBeVisible()

        const htmlLang = await this.page.locator('html').getAttribute('lang')
        expect(htmlLang).toBe('es')
    }

}